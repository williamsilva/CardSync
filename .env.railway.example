SPRING_PROFILES_ACTIVE=prod
CARDSYNC_ISSUER=https://auth.nimbussystems.com.br
CARDSYNC_SPA_BASE_URL=https://cardsync.com.br
CARDSYNC_ALLOWED_ORIGIN=https://cardsync.com.br
CARDSYNC_BFF_CLIENT_ID=cardsync-bff
CARDSYNC_BFF_CLIENT_SECRET=change-me
CARDSYNC_RESOURCE_SERVER_AUDIENCE=cardsync-api
CARDSYNC_COOKIE_SECURE=true
CARDSYNC_COOKIE_SAMESITE=Lax
# Domínio do próprio CardsyncServer (sem protocolo) — obrigatório, sem default.
CARDSYNC_COOKIE_DOMAIN=api.cardsync.com.br
NIMBUS_AUTH_BASE_URL=https://auth.nimbussystems.com.br
NIMBUS_INTERNAL_API_SECRET=change-me
CARDSYNC_EMAIL_IMPL=brevo
CARDSYNC_EMAIL_FROM_NAME=CardSync
CARDSYNC_EMAIL_FROM_EMAIL=contato@cardsync.com.br
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false
SPRING_DATASOURCE_URL=jdbc:postgresql://<PGHOST>:<PGPORT>/<PGDATABASE>?sslmode=require
SPRING_DATASOURCE_USERNAME=<PGUSER>
SPRING_DATASOURCE_PASSWORD=<PGPASSWORD>
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseContainerSupport

# Requer um Volume do Railway montado neste caminho (ver README para o passo a passo).
# Sem isso, os arquivos enviados/pendentes de processamento somem a cada deploy/restart.
FILE_PROCESSING_BASE_PATH=/data/cardsync
